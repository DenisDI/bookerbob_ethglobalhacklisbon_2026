{
  "name": "context-bands-mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server: coarse onchain activity bands (T1-T4) for an address, from Messari standardized subgraphs.",
  "bin": {
    "context-bands-mcp": "bin/context-bands-mcp.mjs"
  },
  "files": [
    "bin",
    "dist",
    "registry",
    "SKILL.md"
  ],
  "scripts": {
