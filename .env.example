# FairTerms — copy to .env and fill in. .env is gitignored; never commit real keys.
# Key sourcing / funding notes: specs/KEYS.md. Spec of record: specs/01-gateway.md.

# --- x402 (bot metering, Base Sepolia) ---
PAYTO_ADDRESS=            # x402 receiver (fresh EVM address)
DEMO_PAYER_KEY=           # bot wallet private key, funded at faucet.circle.com

# --- World AgentKit ---
AGENT_PRIVATE_KEY=        # AgentBook-registered agent wallet
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=

# --- The Graph (context bands) ---
GRAPH_USDC_KEY=           # Base MAINNET wallet holding $2-5 USDC (keyless x402 path)
GRAPH_API_KEY=            # Studio key, backup only

# --- Inventory (flexrep MCP) ---
BOOKER_TOKEN=

# --- Hedera (scheduled settlement, testnet) ---
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=

# --- Local ports (defaults; override if taken) ---
GATEWAY_PORT=3000
MCP_HTTP_PORT=3001
WEB_PORT=5173
