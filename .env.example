# BookerBob — copy to .env and fill in. Never commit real keys.
# All project secrets use the LISBON2026_ prefix.
# Key sourcing: specs/KEYS.md. Spec of record: specs/01-gateway.md.

# --- x402 (bot metering) ---
LISBON2026_PAYTO_ADDRESS=       # x402 receiver (fresh EVM address)
LISBON2026_DEMO_PAYER_KEY=      # bot wallet private key

# --- World AgentKit ---
LISBON2026_AGENT_PRIVATE_KEY=   # AgentBook-registered agent wallet
LISBON2026_WORLD_APP_ID=
LISBON2026_WORLD_RP_ID=
LISBON2026_WORLD_SIGNING_KEY=

# --- The Graph (context bands) ---
LISBON2026_GRAPH_USDC_KEY=      # Base MAINNET wallet, $2-5 USDC (x402 path)
LISBON2026_GRAPH_API_KEY=       # Studio key, backup only

# --- Inventory (booker MCP) ---
LISBON2026_BOOKER_MCP_URL=      # default in code if unset
LISBON2026_BOOKER_TOKEN=
LISBON2026_BOOKER_BOOKING_ENABLED=false
LISBON2026_INVENTORY_SOURCE=auto   # auto | live | cached

# --- Hedera (scheduled settlement, testnet) ---
# Agent locks terms; guest carries risk. Operator signs demo schedules.
LISBON2026_HEDERA_ACCOUNT_ID=
LISBON2026_HEDERA_PRIVATE_KEY=
# optional payee; default 0.0.98 (self-transfer is invalid)
# LISBON2026_HEDERA_PAYEE_ACCOUNT_ID=

# --- Optional context bands API ---
LISBON2026_CONTEXT_API_URL=
LISBON2026_CONTEXT_API_KEY=

# --- Privy (wallet auth → consented address for Graph later) ---
# Dashboard allowed origins: http://localhost:5173 , https://lisbonhack.world
VITE_LISBON2026_PRIVY_APP_ID=
LISBON2026_PRIVY_APP_ID=
LISBON2026_PRIVY_APP_SECRET=
LISBON2026_PRIVY_JWKS_URL=
# optional instead of JWKS fetch:
# LISBON2026_PRIVY_JWT_VERIFICATION_KEY=

# --- Credential mode ---
# Empty (the default) means real World verification, which needs no secret.
# Set to stand_in only for local work without a registered agent wallet: the
# stand-in accepts dev:<anything> and can never return verified.
LISBON2026_CREDENTIAL_MODE=

# World Chain RPC for the AgentBook lookup. Empty uses viem's chain default,
# which is a shared public endpoint: fine from a laptop, not something to lean on
# from a datacentre IP.
LISBON2026_WORLD_RPC_URL=

# --- Public origin ---
# The URL callers actually reach, used to check what an AgentKit credential was
# issued for. Behind a proxy that terminates TLS the socket is plain HTTP, so the
# gateway cannot work this out from the connection. Left empty it falls back to
# X-Forwarded-Proto / X-Forwarded-Host. Not a secret; set in fly.toml for deploys.
LISBON2026_PUBLIC_URL=

# --- Local ports / paths (no prefix — machine-local only) ---
GATEWAY_PORT=3000
MCP_HTTP_PORT=3001
WEB_PORT=5173
# VITE_LISBON2026_GATEWAY_URL=http://localhost:3000
